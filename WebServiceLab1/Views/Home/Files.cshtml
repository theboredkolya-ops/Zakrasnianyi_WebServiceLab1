@model List<string>

@{
    ViewData["Title"] = "Завантажені файли";
}

<div class="container mt-5">
    <h2>Завантажені файли</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info mt-3">
            Завантажених файлів поки немає.
        </div>
    }
    else
    {
        <div class="list-group mt-3">
            @foreach (var file in Model)
            {
                <a asp-action="ViewFile"
                   asp-route-fileName="@file"
                   target="_blank"
                   class="list-group-item list-group-item-action">
                    @file
                </a>
            }
        </div>
    }

    <a asp-action="Upload" class="btn btn-primary mt-3">
        Завантажити новий файл
    </a>
</div>